{
  "name": "recall-ai",
  "version": "1.0.0",
  "description": "Recall AI: A chat agent that answers fast, gets facts right, and remembers what the user asked and when.",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "migrate": "npm run migrate --workspace=server",
    "start": "npm run start --workspace=server",
    "bench": "npm run bench --workspace=server",
    "eval": "npm run eval --workspace=server"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

